# SomaAí - Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais reais
# NÃO COMMITAR O ARQUIVO .env REAL (contém segredos)

# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://seu-project-ref.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# ============================================
# GOOGLE SIGN-IN
# ============================================
# Web Client ID do Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs > Web application)
# Formato: 123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=seu-web-client-id.apps.googleusercontent.com

# ============================================
# APPLE SIGN-IN
# ============================================
# Service ID (Identifier) criado no Apple Developer Portal (Certificates, Identifiers & Profiles > Identifiers > Services IDs)
# Exemplo: com.seuapp.somaai
APPLE_CLIENT_ID=com.seuapp.somaai

# Redirect URI configurada no Supabase e no Apple Developer Portal (Services ID > Configure > Return URLs)
# Deve ser EXATAMENTE: https://SEU_PROJECT_REF.supabase.co/auth/v1/callback
APPLE_REDIRECT_URI=https://seu-project-ref.supabase.co/auth/v1/callback

# ============================================
# OUTRAS CONFIGURAÇÕES
# ============================================
# Esquema de deep link do app (AndroidManifest.xml / Info.plist)
APP_SCHEME=somaai